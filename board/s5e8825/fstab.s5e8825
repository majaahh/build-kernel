#<src>                            <mnt_point>        <type> <mnt_flags and options>                                                                                         <fs_mgr_flags>
system                            /system            erofs  ro                                                                                                              logical,first_stage_mount
system                            /system            ext4   ro                                                                                                              logical,first_stage_mount
product                           /product           erofs  ro                                                                                                              logical,first_stage_mount
product                           /product           ext4   ro                                                                                                              logical,first_stage_mount
vendor                            /vendor            erofs  ro                                                                                                              logical,first_stage_mount
vendor_dlkm                       /vendor_dlkm       erofs  ro                                                                                                              logical,first_stage_mount
odm                               /odm               erofs  ro                                                                                                              logical,first_stage_mount,nofail
/dev/block/by-name/vbmeta         /vbmeta            emmc   defaults                                                                                                        first_stage_mount
/dev/block/by-name/keystorage     /keystorage        emmc   defaults                                                                                                        first_stage_mount
/dev/block/by-name/harx           /harx              emmc   defaults                                                                                                        first_stage_mount
/dev/block/by-name/efs            /mnt/vendor/efs    ext4   noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic                         first_stage_mount,wait,formattable,check
/dev/block/by-name/cpefs          /mnt/vendor/cpefs  ext4   noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic                         first_stage_mount,wait,check,nofail
/dev/block/by-name/metadata       /metadata          ext4   noatime,nosuid,nodev,noauto_da_alloc,discard,journal_checksum,data=ordered,errors=panic,sync                    first_stage_mount,check
